# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# This file is COMMITTED — keep it placeholders only, never real keys.

# --- Alpaca (paper trading) ---
# Create paper keys at https://app.alpaca.markets/ (Paper account).
ALPACA_API_KEY=
ALPACA_SECRET=
# Paper endpoint. Do NOT point this at the live trading API in v1.
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# --- Telegram alerts ---
# Bot token from @BotFather; chat id from the chat you want alerts in.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ollama (local LLM journal) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
