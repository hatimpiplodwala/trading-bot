# systemd unit for the ICT bot (Phase 8 — placeholder).
# Install: copy to /etc/systemd/system/ictbot.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now ictbot
[Unit]
Description=ICT SPY paper-trading bot
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ict-bot
EnvironmentFile=/opt/ict-bot/.env
ExecStart=/opt/ict-bot/.venv/bin/python -m ict_bot.main
Restart=always
RestartSec=5
Nice=10
CPUWeight=50

[Install]
WantedBy=multi-user.target
